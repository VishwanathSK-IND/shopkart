        {
          "name": "Test 4 - Verify Payment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Razorpay signs a successful payment as HMAC_SHA256(order_id + \"|\" + payment_id, key_secret).",
                  "// If razorpayKeySecret is set (locally only!), build the same signature here.",
                  "// Otherwise razorpayPaymentId / razorpaySignature must hold values from a real Test Mode payment.",
                  "const secret = pm.collectionVariables.get(\"razorpayKeySecret\");",
                  "if (secret) {",
                  "  const CryptoJS = require(\"crypto-js\");",
                  "  const paymentId = \"pay_postman_\" + Date.now();",
                  "  const orderId = pm.collectionVariables.get(\"razorpayOrderId\");",
                  "  const signature = CryptoJS.HmacSHA256(orderId + \"|\" + paymentId, secret).toString(CryptoJS.enc.Hex);",
                  "  pm.collectionVariables.set(\"razorpayPaymentId\", paymentId);",
                  "  pm.collectionVariables.set(\"razorpaySignature\", signature);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const order = pm.response.json().order;",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paymentStatus is PAID\", () => pm.expect(order.paymentStatus).to.eql(\"PAID\"));",
                  "pm.test(\"status is PLACED\", () => pm.expect(order.status).to.eql(\"PLACED\"));",
                  "pm.test(\"Payment id is stored\", () => pm.expect(order.razorpayPaymentId).to.eql(pm.collectionVariables.get(\"razorpayPaymentId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/verify-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
