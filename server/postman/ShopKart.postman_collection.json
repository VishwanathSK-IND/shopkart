{
  "info": {
    "name": "ShopKart API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "shopKartOrderId",
      "value": ""
    },
    {
      "key": "razorpayOrderId",
      "value": ""
    },
    {
      "key": "razorpayPaymentId",
      "value": ""
    },
    {
      "key": "razorpaySignature",
      "value": ""
    },
    {
      "key": "razorpayKeySecret",
      "value": ""
    },
    {
      "key": "expectedAmount",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"labtest@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9999999999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"labtest@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current Customer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/customers/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"RGB mechanical keyboard with blue switches.\",\n  \"price\": 2999,\n  \"category\": \"Electronics\",\n  \"image\": \"https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500&h=500&fit=crop\",\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Get All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the first product's _id so the Wishlist requests can use {{productId}}",
                  "const body = pm.response.json();",
                  "if (body.products && body.products.length > 0) {",
                  "  pm.collectionVariables.set(\"productId\", body.products[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=keyboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "keyboard"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?category=Electronics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Electronics"
                }
              ]
            }
          }
        },
        {
          "name": "Search + Filter Combined",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=keyboard&category=Electronics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "keyboard"
                },
                {
                  "key": "category",
                  "value": "Electronics"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Wishlist",
      "item": [
