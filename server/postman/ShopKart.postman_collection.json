            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/wishlist/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist",
                "000000000000000000000000"
              ]
            }
          }
        },
        {
          "name": "Remove from Wishlist",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Remove Again (expect 404)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Test 1 - Add New Item (quantity 1)",
