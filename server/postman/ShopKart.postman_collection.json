    },
    {
      "name": "Orders",
      "description": "Lab 06: checkout, Razorpay payment and order history.\n\nBefore running: set RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET in server/.env and restart the server, log in (Customers → Login), run Products → Get All Products, and make sure your cart is empty (e.g. run the Cart folder up to Test 6, or remove items). Then run this folder top to bottom.\n\nTest 4 needs a valid Razorpay signature. Either:\n  A) set the collection variable razorpayKeySecret (CURRENT value only, never commit or export it) and the pre-request script signs the payment exactly like Razorpay does, or\n  B) pay in the React app with DevTools open, copy razorpay_payment_id and razorpay_signature from the verify-payment request, and paste them into razorpayPaymentId / razorpaySignature.",
      "item": [
        {
          "name": "Test 1 - Empty Cart (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Says cart is empty\", () => pm.expect(pm.response.json().message).to.match(/empty/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/create-payment-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "create-payment-order"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Aarav Sharma\",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"22 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  }\n}"
            }
          }
        },
        {
          "name": "Invalid Pincode (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/create-payment-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "create-payment-order"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Aarav Sharma\",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"22 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"5600\"\n  }\n}"
            }
          }
        },
        {
          "name": "Whitespace-only Name (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/create-payment-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "create-payment-order"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"   \",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"22 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  }\n}"
            }
          }
        },
        {
          "name": "Setup - Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Remember what the order should cost (in paise) so later tests can check it.",
                  "const cart = pm.response.json().cart;",
                  "const paise = cart.reduce((sum, i) => sum + i.product.price * i.quantity, 0) * 100;",
                  "pm.collectionVariables.set(\"expectedAmount\", Math.round(paise));",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/cart/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Test 8 - Fake totalAmount Is Ignored",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const expected = Number(pm.collectionVariables.get(\"expectedAmount\"));",
                  "pm.test(\"Amount is calculated by the server, not 1\", () => pm.expect(pm.response.json().amount).to.eql(expected));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/create-payment-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "create-payment-order"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Aarav Sharma\",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"22 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  },\n  \"totalAmount\": 1\n}"
            }
          }
        },
        {
          "name": "Test 2 - Create Payment Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"shopKartOrderId\", body.shopKartOrderId);",
                  "pm.collectionVariables.set(\"razorpayOrderId\", body.razorpayOrderId);",
                  "const expected = Number(pm.collectionVariables.get(\"expectedAmount\"));",
                  "pm.test(\"Amount is in paise\", () => pm.expect(body.amount).to.eql(expected));",
                  "pm.test(\"Currency is INR\", () => pm.expect(body.currency).to.eql(\"INR\"));",
                  "pm.test(\"Only the public test Key ID is returned\", () => pm.expect(body.key).to.match(/^rzp_test_/));",
                  "pm.test(\"Key Secret is never returned\", () => pm.expect(pm.response.text()).to.not.match(/secret/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/create-payment-order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "create-payment-order"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Aarav Sharma\",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"22 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\"\n  }\n}"
            }
          }
        },
        {
          "name": "Test 3 - Cart Unchanged Before Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const cart = pm.response.json().cart;",
                  "pm.test(\"Cart still has items\", () => pm.expect(cart.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            }
          }
        },
        {
          "name": "Test B - Fake Signature (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Says signature is invalid\", () => pm.expect(pm.response.json().message).to.eql(\"Invalid payment signature\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/verify-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "verify-payment"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopKartOrderId\": \"{{shopKartOrderId}}\",\n  \"razorpay_order_id\": \"{{razorpayOrderId}}\",\n  \"razorpay_payment_id\": \"pay_fake123\",\n  \"razorpay_signature\": \"fake_signature\"\n}"
            }
          }
        },
        {
          "name": "Cart Still Full After Fake Signature",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const cart = pm.response.json().cart;",
                  "pm.test(\"Cart was NOT cleared\", () => pm.expect(cart.length).to.be.above(0));"
                ]
              }
            }
          ],
