PORT=3000
MONGO_URI=mongodb://localhost:27017/shopkart
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# Razorpay TEST MODE keys (Dashboard → Account & Settings → API Keys).
# The secret stays on the server only. Never commit the real .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Frontend URL allowed by CORS. Leave unset locally (any localhost port is allowed);
# set it to your Vercel URL in production.
CLIENT_ORIGIN=http://localhost:5173
